# =========================================================================
# AURA AGI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values.
# =========================================================================

# --- API KEYS (Required for cloud LLM stacks) ---
OPENROUTER_API_KEY=your_openrouter_key_here
TAVILY_API_KEY=your_tavily_key_here

# --- DATABASE (SurrealDB) ---
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=aura
SURREAL_DB=main

# --- BACKEND (FastAPI) ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
APP_TIMEZONE=UTC

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SOCKET_URL=ws://localhost:8080/ws

# =========================================================================
# MODEL STACKS — Hot-swappable via AURA_MODEL_STACK_INDEX or chat navbar
# Stack 0 = "Lean"  (fast / cost-efficient)
# Stack 1 = "Core"  (balanced quality / speed)
# Stack 2 = "Titan" (maximum capability)
# =========================================================================

# --- ACTIVE STACK SELECTOR ---
# Change at runtime via POST /system/model-stack or the Lean/Core/Titan toggle
AURA_MODEL_STACK_INDEX=0

# --- STACK 0: Lean (default) ---
AURA_L1_MODEL=mistralai/mistral-7b-instruct
AURA_L2_MODEL=anthropic/claude-3.5-sonnet
AURA_L3_MODEL=deepseek/deepseek-chat
AURA_L4_MODEL=qwen/qwen-2.5-72b-instruct
AURA_L5_MODEL=google/gemini-flash-1.5
# SOVEREIGN-NATIVE: embeddings ALWAYS run locally (nomic-embed-text-v1.5, 768D)
# Cloud LLMs must NEVER write to the vector space — schema is locked at 768 dims.
AURA_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
AURA_EMBEDDING_DIMENSION=768

# --- STACK 1: Core (balanced) ---
AURA_L1_MODEL1=mistralai/mistral-7b-instruct
AURA_L2_MODEL1=google/gemini-flash-latest
AURA_L3_MODEL1=x-ai/grok-4.3
AURA_L4_MODEL1=qwen/qwen-2.5-72b-instruct
AURA_L5_MODEL1=google/gemini-3.1-flash-lite
# SOVEREIGN-NATIVE: embeddings must stay local even when cloud LLMs are active
AURA_EMBEDDING_MODEL1=nomic-ai/nomic-embed-text-v1.5
AURA_EMBEDDING_DIMENSION1=768

# --- STACK 2: Titan (maximum capability) ---
AURA_L1_MODEL2=google/gemma-4-26b-a4b-it
AURA_L2_MODEL2=deepseek/deepseek-v4-pro
AURA_L3_MODEL2=google/gemini-3.1-pro-preview
AURA_L4_MODEL2=anthropic/claude-haiku-4.5
AURA_L5_MODEL2=qwen/qwen3.6-plus
# SOVEREIGN-NATIVE: embeddings must stay local even when cloud LLMs are active
AURA_EMBEDDING_MODEL2=nomic-ai/nomic-embed-text-v1.5
AURA_EMBEDDING_DIMENSION2=768

# =========================================================================
# LOCAL AI (Ollama / SGLang / Qwen3-TTS)
# =========================================================================

# Master switch: route ALL LLM calls through Ollama when true
AURA_LOCAL_LLM_ENABLED=false
AURA_LOCAL_LLM_FALLBACK_TO_CLOUD=true
AURA_OLLAMA_URL=http://localhost:11434

# --- Context-Mode Inference Routing ---
# When context_mode == "private_rp" or "deep_work", L1/L2/L3 are routed here.
# Must be an OpenAI-compatible /v1/chat/completions endpoint.
# Supported: llama.cpp server, vLLM, Ollama /v1, LM Studio, SGLang
AURA_LOCAL_INFERENCE_URL=http://127.0.0.1:30000/v1
AURA_LOCAL_INFERENCE_API_KEY=
AURA_LOCAL_INFERENCE_TIMEOUT=300

# =========================================================================
# SGLang Constrained Sampler
# SGLang provides radix-attention + constrained output for XML thought clusters.
# Active ONLY when AURA_LOCAL_LLM_ENABLED=true AND AURA_SGLANG_ENABLED=true.
# Default server port: 30000 (launch with: python -m sglang.launch_server ...)
# =========================================================================
AURA_SGLANG_ENABLED=false
AURA_SGLANG_URL=http://127.0.0.1:30000
# Enable SGLang sampling params for L1 (instinct) and L3 (synthesis)
AURA_SGLANG_L1_ENABLED=true
AURA_SGLANG_L3_ENABLED=true
AURA_SGLANG_MAX_NEW_TOKENS=4096
AURA_SGLANG_TEMPERATURE=0.7
AURA_SGLANG_TOP_P=0.9
AURA_SGLANG_TOP_K=50
AURA_SGLANG_REPETITION_PENALTY=1.05

# =========================================================================
# TTS (Edge-TTS cloud / Qwen3-TTS local / FishAudio local)
# =========================================================================
AURA_QWEN3_TTS_ENABLED=true
AURA_QWEN3_TTS_URL=http://127.0.0.1:50000
AURA_QWEN3_TTS_SPEAKER=serena
AURA_QWEN3_TTS_MODEL_DIR=./Qwen3-TTS

# FishAudio (Fish-Speech 1.5) — local TTS with voice cloning
AURA_FISH_AUDIO_ENABLED=true
AURA_FISH_AUDIO_URL=http://127.0.0.1:50001
AURA_FISH_AUDIO_SPEAKER=default
AURA_FISH_AUDIO_MODEL_DIR=./FishAudio

# Active TTS provider: edge | qwen3 | fishaudio
AURA_TTS_PROVIDER=edge

# =========================================================================
# SYSTEM SETTINGS
# =========================================================================
AURA_SYSTEM_WAKE_WORD=Aura
AURA_SYSTEM_IDLE_AFTER_MINUTES=15
AURA_SYSTEM_DREAM_AFTER_MINUTES=30
AURA_SYSTEM_AUTO_WAKE_ON_QUERY=false
AURA_WORKSPACE_PATH=/app/workspace
AURA_CODE_EXECUTION_ENABLED=false
AURA_AGENT_LOOP_MAX_ITERATIONS=10
AURA_AGENT_LOOP_REQUIRE_APPROVAL=true

# =========================================================================
# DISCORD BOT (Optional)
# =========================================================================
# Create a bot at https://discord.com/developers/applications
# 1. New Application → Bot → Add Bot
# 2. Copy the token below
# 3. Enable "Message Content Intent" under Privileged Gateway Intents
# 4. Invite with: https://discord.com/api/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=2147485696&scope=bot
AURA_DISCORD_ENABLED=false
AURA_DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Prefix for text commands (e.g., !aura ping, !aura chat Hello)
AURA_DISCORD_COMMAND_PREFIX=!aura
# Comma-separated channel IDs the bot should respond in (empty = all channels)
AURA_DISCORD_ALLOWED_CHANNELS=
# Max characters per Discord message (Discord limit: 2000)
AURA_DISCORD_MAX_MESSAGE_LENGTH=2000
# Show "Aura is typing..." indicator while processing
AURA_DISCORD_STREAM_RESPONSES=true
# Active mode: respond to ALL messages (not just @mentions) with per-channel cooldown
AURA_DISCORD_ACTIVE_MODE=false
AURA_DISCORD_ACTIVE_COOLDOWN_SECONDS=30
